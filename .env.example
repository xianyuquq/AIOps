# AI 智能运维平台 —— 环境变量示例
#
# 用法：复制为 .env 并按需修改；或直接设置为系统环境变量。
# 真实的 .env 已被 .gitignore 排除，不会被提交。

# ---------------------------------------------------------------- 基础
# 数据库（默认 SQLite，放在 backend/data/ 下）
# AIOPS_DATABASE_URL=sqlite:///./data/aiops.db
# 数据目录（存放 aiops.db 与 master.key）
# AIOPS_DATA_DIR=./data

# 凭据加密主密钥。**务必修改**，泄露等同于所有服务器/数据库口令泄露。
# 留空时首次启动会自动生成到 data/master.key。
# AIOPS_SECRET_KEY=

# 管理员初始口令
# AIOPS_ADMIN_PASSWORD=admin123

# 监听地址与端口
# AIOPS_HOST=127.0.0.1
# AIOPS_PORT=8848

# ---------------------------------------------------------------- SSH
# AIOPS_SSH_CONNECT_TIMEOUT=10
# AIOPS_SSH_COMMAND_TIMEOUT=60

# ---------------------------------------------------------------- AI（可选）
# 未配置时平台其余功能不受影响。
#
# 注意：也可以在「AI 助手 → 模型配置」界面里填写，改完即时生效、无需重启。
# 取值优先级：**界面设置 > 环境变量 > 代码默认**。
# 这里填的值会被界面设置覆盖；界面上会显示每一项的实际来源。
# AIOPS_LLM_ENABLED=false
# AIOPS_LLM_BASE_URL=https://api.deepseek.com/v1
# AIOPS_LLM_API_KEY=
# AIOPS_LLM_MODEL=deepseek-chat
# AIOPS_LLM_TIMEOUT=60
# AIOPS_LLM_MAX_TOKENS=4096

# ---------------------------------------------------------------- 验证脚本用（仅测试）
# 真实环境的凭据不写进源码，跑相关验证脚本时通过环境变量传入。
#
# Kingbase 真机验证（tests/verify_kingbase_real.py、seed_test_data.py）
# AIOPS_TEST_KINGBASE_HOST=192.168.203.128
# AIOPS_TEST_KINGBASE_PORT=54321
# AIOPS_TEST_KINGBASE_USER=system
# AIOPS_TEST_KINGBASE_DB=test
# AIOPS_TEST_KINGBASE_PASSWORD=
#
# 本地 Docker 测试库（一次性容器，按需覆盖）
# AIOPS_TEST_LOCAL_DB_HOST=127.0.0.1
# AIOPS_TEST_LOCAL_DB_PASSWORD=Test1234
# AIOPS_TEST_LOCAL_PG_PORT=5432
# AIOPS_TEST_LOCAL_MYSQL_PORT=3306
